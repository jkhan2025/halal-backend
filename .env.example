# Copy to .env locally and on Render; DO NOT commit secrets
PORT=5050
HOST=0.0.0.0
CORS_ORIGIN=*

API_KEY=
ADMIN_KEY=

MAX_JSON_MB=15
MAX_IMAGE_MB=8

MONGO_URI=
MONGODB_URI=

STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=halalquest-dev
# CDN_BASE_URL= (local mode only; NOT used for moderation photo access —
#   evidence photos are private, signed URLs are generated at read time
#   and never depend on a public CDN base)
# STORAGE_KEY_PREFIX= (e.g. "prod" — environment namespace prefix for
#   storage keys, 1-40 chars, letters/digits/"_"/"-" only, no "/". Optional;
#   omit for no prefix. See src/lib/storageKey.js.)
#
# SUPABASE_SERVICE_ROLE_KEY is a SECRET — it grants full, RLS-bypassing
# access to this Supabase project's storage (and everything else in the
# project). It is read only by the backend, passed directly to
# createClient(), and must never be sent to the frontend or used anywhere
# in mobile config. If/when Supabase Auth is later adopted on the frontend,
# that uses the separate, public-safe SUPABASE_ANON_KEY — do not conflate
# the two. SUPABASE_URL itself is not secret and may be shared between
# Storage and a future Auth integration.
#
# The Supabase bucket is assumed private (created with public: false): no
# object is ever uploaded with a public-access option. Moderation reads use
# short-lived signed GET URLs generated on demand, never a permanent public
# URL.
#
# Retired: this project previously used AWS S3 (STORAGE_DRIVER=s3,
# S3_REGION/S3_BUCKET/S3_ENDPOINT, AWS SDK credential chain). That path has
# been replaced by Supabase Storage above, per the approved S3->Supabase
# migration; STORAGE_DRIVER no longer accepts "s3".
